{
  "name": "mifta-qa-test",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "bddgen && playwright test",
    "test:staging": "BASE_URL=https://www.saucedemo.staging.com npm test",
    "test:prod": "BASE_URL=https://www.saucedemo.com npm test",
    "test:headed": "bddgen && playwright test --headed",
    "test:ui": "bddgen && playwright test --ui",
    "report:playwright": "playwright show-report",
    "report:generate": "allure generate allure-results --clean -o allure-report",
    "report:open": "allure open allure-report",
    "report": "npm run report:generate && npm run report:open",
    "clean": "rm -rf allure-results allure-report playwright-report test-results .features-gen"
  },
  "keywords": [],
  "type": "module",
  "devDependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.11",
    "allure": "^3.33.0",
    "allure-cucumberjs": "^3.15.0",
    "allure-js-commons": "^3.15.0",
    "allure-playwright": "^3.15.0",
    "dotenv": "^18.0.10",
    "playwright-bdd": "^9.2.1",
    "tsx": "^4.23.15"
  }
}
