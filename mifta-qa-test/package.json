{
  "name": "mifta-qa-test",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "npm run test:web",
    "test:web": "NODE_OPTIONS=\"--import tsx\" cucumber-js",
    "test:web:headed": "HEADED=true npm run test:web",
    "report:generate": "allure generate allure-results --clean -o allure-report",
    "report:open": "allure open allure-report",
    "report": "npm run report:generate && npm run report:open",
    "clean": "rm -rf allure-results allure-report"
  },
  "keywords": [],
  "type": "module",
  "devDependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.11",
    "allure": "^3.33.0",
    "allure-cucumberjs": "^3.15.0",
    "allure-js-commons": "^3.15.0",
    "dotenv": "^18.0.10",
    "tsx": "^4.23.15"
  }
}
